# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this application is hosted (used for webhook setup instructions).
APP_URL="MY_APP_URL"

# MONGODB_URI: Connection string for MongoDB (e.g., MongoDB Atlas URI).
MONGODB_URI=""
MONGODB_DB_NAME="pageflow_ai"

# Meta Graph API & Messenger Webhook secrets (server-side only).
META_PAGE_ACCESS_TOKEN=""
META_APP_SECRET=""
META_VERIFY_TOKEN=""

# Optional admin login override (if omitted, claim the first admin account in the UI).
ADMIN_EMAIL=""
ADMIN_PASSCODE=""
